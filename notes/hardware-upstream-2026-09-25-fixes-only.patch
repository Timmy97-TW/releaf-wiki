+/* =====================================================================
+   25 Sep 2026, wiki side (notes/review-2026-09-25/hardware.md)
+   ===================================================================== */
+
+/* Review notes (assets/js/review-notes.js, demo wiki only). The shared style
+   is amber ink on cream, written for the wiki's paper ground. Here two things
+   break it: `.sec p b` (0,1,2) outranks the note's own `b` rule and paints the
+   "Works." / "Fix." labels in the night --fg, near-white on cream; and the hub
+   and the notebook are dark all the way down. So on this section the note is
+   a dark amber panel with light text, and on the white record (doc-light) it
+   goes back to the wiki's cream. `html body` lifts every rule over `.sec p`. */
+html body .review-note {
+  margin: 1.75rem 0 .5rem; padding: .85rem 1.1rem .9rem; max-width: 68ch;
+  font: 400 .9rem/1.55 Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
+  background: #1d1606; color: #efe3c6; border: 1px dashed #c98a1b;
+  border-radius: 0; box-shadow: none; position: relative; z-index: 2;
+}
+/* the same box whether or not review-notes.js has run (it injects the shared
+   style late, and not at all with JavaScript off) */
+html body .review-note p {
+  margin: 0 0 .45rem; max-width: none; color: inherit;
+  font: inherit; letter-spacing: 0; text-transform: none;
+}
+html body .review-note p:last-child { margin-bottom: 0; }
+html body .review-note b { font-weight: 650; }
+html body .review-note .review-note__head {
+  font-size: .6875rem; font-weight: 650; letter-spacing: .12em;
+  text-transform: uppercase; margin-bottom: .5rem;
+}
+html body .review-note .review-note__head span { text-transform: none; letter-spacing: 0; font-weight: 500; }
+html.review-off body .review-note { display: none; }
+@media print { html body .review-note { display: none; } }
+html body .review-note b { color: #ffc766; }
+html body .review-note .review-note__head { color: #e2a43c; }
+html body .review-note .review-note__head span { color: #d6c6a1; }
+html body.doc-light .review-note { background: #fffaf0; color: #3d3320; border-color: #92610c; }
+html body.doc-light .review-note b { color: #6b4708; }
+html body.doc-light .review-note .review-note__head { color: #92610c; }
+html body.doc-light .review-note .review-note__head span { color: #6b5a3a; }
+/* on the hub the notes sit in wide dark sections; give them the reading measure and a gutter */
+html body.hub .review-note { margin: 2rem auto 1rem; width: calc(100% - 32px); max-width: 68ch; }
+
+/* The section strip over the white record. The bar's scrim fades out across
+   the strip, so over paper the strip sat on mid-grey: the current page's
+   near-white label measured about 1.3:1 and the record's text showed through
+   the links. On the record the scrim stays solid to the strip's bottom edge,
+   then fades; the same on the hub, whose notebook sheet is cream, and on the
+   notebook page. The strip itself sits under the bar's scrim (z-index 49 against
+   50), so on the record it is lifted over it with the same solid fill, or the
+   solid scrim would hide its links. */
+body.doc-light .sitenav--dark.is-scrolled ~ .hwnav,
+body.hub .sitenav--dark.is-scrolled ~ .hwnav,
+body[data-instrument="notebook"] .sitenav--dark.is-scrolled ~ .hwnav {
+  z-index: 51; background: rgb(5 6 10 / .96); transition: opacity .3s, background-color .35s;
+}
+body.doc-light .sitenav--dark.is-scrolled .sitenav__bar::before,
+body.hub .sitenav--dark.is-scrolled .sitenav__bar::before,
+body[data-instrument="notebook"] .sitenav--dark.is-scrolled .sitenav__bar::before {
+  background: linear-gradient(180deg,
+              rgb(5 6 10 / .96) 0%,
+              rgb(5 6 10 / .96) calc(100% - 52px),
+              rgb(5 6 10 / 0) 100%);
+}
+
+/* The jump pill over the white record: hydroponics already fixed this in its
+   own stylesheet (a grey smudge at 1.1:1); the other three records need it too. */
+body.doc-light .palette-hint {
+  background: #fff; color: var(--muted); opacity: 1;
+  border-color: var(--line-2);
+  -webkit-backdrop-filter: none; backdrop-filter: none;
+}
+body.doc-light .palette-hint:hover, body.doc-light .palette-hint:focus-visible { color: var(--fg); }
+
+/* The notebook page's footer had no side padding: the licence lines started
+   at x = 0 and ran under the fixed corner buttons. */
+body[data-instrument="notebook"] .doc-foot {
+  padding: 2rem clamp(16px, 4vw, 48px) 6rem;
+}
+
+/* The hub's previous / next pair (Dry Lab tab: Math Model, Hardware, Software).
+   Same markup as the generated pages' nav.pagenav, drawn on the dark ground:
+   hairline boxes, no radius, the label in the section's mono caps. */
+body.hub .pagenav {
+  position: relative; z-index: 2;
+  display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
+  max-width: 68rem; margin: 3rem auto 0; padding: 0 clamp(16px, 4vw, 48px) 3rem;
+}
+body.hub .pagenav a {
+  display: grid; gap: .35rem; padding: 1rem 1.2rem;
+  border: 1px solid rgba(255, 255, 255, .16); border-radius: 0;
+  color: #eef2f6; text-decoration: none;
+  transition: border-color .2s, background-color .2s;
+}
+body.hub .pagenav a:hover { border-color: rgba(255, 255, 255, .45); background: rgba(255, 255, 255, .03); }
+body.hub .pagenav a:focus-visible { outline: 2px solid #3ddc8b; outline-offset: 3px; }
+body.hub .pagenav .is-next { text-align: right; }
+body.hub .pagenav b {
+  font: 500 .6875rem/1.2 ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
+  letter-spacing: .2em; text-transform: uppercase; color: #9aa3af;
+}
+body.hub .pagenav .is-prev b::before { content: "\2190\00a0"; }
+body.hub .pagenav .is-next b::after { content: "\00a0\2192"; }
+body.hub .pagenav span { font: 500 1.05rem/1.3 Inter, system-ui, sans-serif; }
+@media (max-width: 480px) { body.hub .pagenav { grid-template-columns: 1fr; } body.hub .pagenav .is-next { text-align: left; } }
